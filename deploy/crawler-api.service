[Unit]
Description=Revisi Studio crawler search API
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/studio-revisi/crawler
EnvironmentFile=-%h/studio-revisi/crawler/.env
ExecStart=%h/studio-revisi/crawler/bin/crawler-api --addr 127.0.0.1:8770
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
