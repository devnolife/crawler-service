[Unit]
Description=Crawler Service — shared academic crawling API (Go)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/crawler-service
EnvironmentFile=-%h/crawler-service/.env
ExecStart=%h/crawler-service/bin/crawler-api --addr 127.0.0.1:8770
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
