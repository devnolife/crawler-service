# Copy to .env and edit. .env is gitignored.
# Postgres dipakai bersama webapp embedded-postgres di port 5432.
CRAWLER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/revisi_crawler

# Port API search service (Go). Backend utama pakai 8765, jadi pilih lain.
CRAWLER_API_HOST=127.0.0.1
CRAWLER_API_PORT=8770

# ── Shared service: auth multi-client ────────────────────────────────────
# Kosongkan untuk mematikan auth (dev only). Request wajib header X-API-Key.
# Format: <api-key>:<nama-client>, dipisah koma.
# Contoh: CRAWLER_API_KEYS="rahasia123:studio-revisi,rahasia456:wizard-research"
CRAWLER_API_KEYS=

# Rate limit per client per menit (default 120)
CRAWLER_RATE_LIMIT_PER_MINUTE=120

# LLM lokal untuk citation/title suggestion
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
